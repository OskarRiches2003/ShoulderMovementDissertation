rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()      { return request.auth != null; }
    function role()            { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isPractitioner()  { return isSignedIn() && role() == 'practitioner'; }
    function isPatient()       { return isSignedIn() && role() == 'patient'; }
    function isAdmin()         { return isSignedIn() && role() == 'admin'; }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /patients/{patientId} {
      allow read: if isPractitioner() || isAdmin()
        || (isPatient() && request.auth.uid == patientId);
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      // Practitioners and admins read all; patients read only their own
      allow read: if isPractitioner() || isAdmin()
        || (isPatient() && resource.data.patientId == request.auth.uid);

      // Only practitioners or admins can create sessions
      allow create: if isPractitioner() || isAdmin();

      // Practitioners can update sessions for their patients (status, review)
      // Patients can update only results/status/timestamps on their own sessions
      allow update: if (isPractitioner() || isAdmin())
        || (isPatient()
            && resource.data.patientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['results', 'status', 'startedAt', 'finishedAt']));
    }
  }
}
